# Reverse-proxy TLS delante de `api` (OpenMRS/Tomcat) - unico punto de entrada HTTP(S)
# publicado al host (ver docker-compose.proxy.yml). Sustituido por envsubst al arrancar
# (imagen oficial nginx:alpine, /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf);
# HTTPS_PORT y UPSTREAM vienen de las variables de entorno del servicio `proxy`.
#
# Resuelve dos riesgos documentados en openmrs-module-seguimientooncologico/docs/seguridad.md:
#   1. HTTP sin TLS: el puerto 8080 SOLO redirige a HTTPS, nunca proxea contenido en claro.
#      Basic Auth y la cookie de sesion nunca salen del host sin cifrar.
#   2. Cookie de sesion sin Secure/SameSite garantizados por el core (context.xml tiene
#      useHttpOnly="false", contradicho por el cookie-config de web.xml pero sin SameSite
#      explicito en ningun lado): `proxy_cookie_flags` fuerza los tres atributos en TODO
#      Set-Cookie que salga hacia el cliente, sin depender de que se corrija upstream.
#   3. /ws/rest/v1/systemsetting servido SIN autenticacion (ver el bloque `location` mas abajo).

# Limitacion de tasa del unico endpoint anonimo del modulo (el enlace del paciente a su
# teleconsulta). El token tiene 256 bits de entropia y se busca por hash, asi que no hay
# enumeracion posible: esto no protege contra adivinar el token, protege contra que ese endpoint
# se use para saturar la base de datos. 30 peticiones por minuto por IP es holgado para un
# paciente que recarga su sala y ridiculo para un atacante.
limit_req_zone $binary_remote_addr zone=telemedicina_invitado:1m rate=30r/m;

server {
	listen 8080;
	server_name _;
	return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
	listen 8443 ssl;
	server_name _;

	ssl_certificate     /etc/nginx/certs/dev.crt;
	ssl_certificate_key /etc/nginx/certs/dev.key;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers HIGH:!aNULL:!MD5;
	ssl_prefer_server_ciphers on;

	add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;

	client_max_body_size 20m;

	location = /nginx-health {
		return 200 "ok\n";
		add_header Content-Type text/plain;
	}

	# BLOQUEADO: /ws/rest/v1/systemsetting sirve las propiedades globales de OpenMRS SIN exigir
	# autenticacion en esta version de webservices.rest (3.5.0). Comprobado atacando el entorno
	# real: un cliente anonimo lee cualquier propiedad por nombre y puede listarlas todas
	# paginadas -- hoy incluye `mail.password`. El recurso upstream declara
	# getRequiredGetPrivilege() = "Get Global Properties", pero su `retrieve` no lo aplica: se
	# probo crear ese privilegio (faltaba en la instancia) y la fuga persistio.
	#
	# Ver openmrs-module-seguimientooncologico/docs/auditoria-seguridad-telemedicina.md §7.1.
	#
	# La aplicacion cliente de este proyecto NO usa este recurso (tiene su propio
	# `configuracion.json`, gateado por privilegio), asi que bloquearlo no rompe nada aca. Si un
	# despliegue instala un frontend que si lo necesite (p.ej. OpenMRS 3.x/O3), quitar este bloque
	# y aceptar el riesgo conscientemente, o parchear webservices.rest.
	location ^~ /openmrs/ws/rest/v1/systemsetting {
		# Se bloquea SOLO la lectura, que es la que no exige autenticacion. La escritura
		# (POST/DELETE) si comprueba el privilegio "Manage Global Properties" en el backend, asi que
		# dejarla pasar no abre nada y evita romper la administracion legitima.
		limit_except POST DELETE PUT { deny all; }

		proxy_pass http://${UPSTREAM};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_cookie_flags ~ secure httponly samesite=lax;
	}

	# Enlace de la teleconsulta del paciente: endpoint del backend que atiende sin
	# autenticacion, por lo que necesita limitacion de tasa (ver limit_req_zone).
	location ^~ /openmrs/module/seguimientoOncologico/telemedicinaInvitado.json {
		limit_req zone=telemedicina_invitado burst=10 nodelay;

		proxy_pass http://${UPSTREAM};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_cookie_flags ~ secure httponly samesite=lax;
	}

	# Reporte de síntomas del paciente (portal ePRO): el otro endpoint que atiende sin
	# autenticación. Misma limitación de tasa que el enlace de la teleconsulta — no protege contra
	# adivinar el token (256 bits por hash, sin enumeración posible) sino contra saturar la base.
	location ^~ /openmrs/ws/rest/v1/reportepaciente {
		limit_req zone=telemedicina_invitado burst=10 nodelay;

		proxy_pass http://${UPSTREAM};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_cookie_flags ~ secure httponly samesite=lax;
	}

	# Resumen del paciente (lectura del portal): mismo tratamiento que la escritura - es el
	# mismo dato clinico sensible y la misma ausencia de autenticacion tradicional.
	location ^~ /openmrs/ws/rest/v1/resumenpaciente {
		limit_req zone=telemedicina_invitado burst=10 nodelay;

		proxy_pass http://${UPSTREAM};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
		proxy_cookie_flags ~ secure httponly samesite=lax;
	}

	location / {
		proxy_pass http://${UPSTREAM};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;

		# Fuerza Secure + HttpOnly + SameSite=Lax en cualquier Set-Cookie del backend,
		# agregando el atributo si falta y sin duplicarlo si ya viene presente.
		proxy_cookie_flags ~ secure httponly samesite=lax;
	}
}
