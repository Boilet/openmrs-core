# Copy to .env and adjust. All values are optional - the stack runs with these defaults.

# ---- OpenMRS / MariaDB ----
OMRS_DB_NAME=openmrs
OMRS_DB_USERNAME=openmrs
OMRS_DB_PASSWORD=openmrs
OMRS_DB_ROOT_PASSWORD=openmrs
OMRS_ADMIN_USER_PASSWORD=Admin123
OMRS_ADMIN_PASSWORD_LOCKED=true

# Set to true to rebuild the project (mvn install) inside the container on every start.
# Defaults to false: the image already contains a freshly built openmrs.war.
OMRS_BUILD=false

# ---- Host ports (pick free ports if yours are taken) ----
OMRS_HTTP_HOST_PORT=8083
OMRS_DEBUG_HOST_PORT=8013
OMRS_SCHEDULER_HOST_PORT=9003
# Uncomment to expose MariaDB on the host (also uncomment the ports block for db in docker-compose.override.yml)
# OMRS_DB_HOST_PORT=3307

# ---- Monitoring ----
GRAFANA_ADMIN_PASSWORD=Admin123
GRAFANA_HOST_PORT=3010
PROMETHEUS_HOST_PORT=9101
PROMETHEUS_RETENTION=30d
